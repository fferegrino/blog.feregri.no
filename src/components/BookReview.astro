---
import StarRating from "./StarRating.astro";

interface Props {
	data: {
		title: string;
		description: string;
		author: string;
		rating: number;
		isbn?: string;
		recommended?: boolean;
		category: string;
		links?: Array<{ url: string; text: string }>;
	};
	slug: string;
}

const { data, slug } = Astro.props;
const { title, description, author, isbn, rating, recommended } = data;
const titleId = isbn ? `book-title-${isbn}` : `book-title-${slug}`;
const coverSrc = isbn
	? `https://ik.imagekit.io/thatcsharpguy/tr:w-500,f-webp,q-80/feregri_no/book-covers/${isbn}.jpeg`
	: "/blog-placeholder-1.jpg";

const articleClass = [
	"relative",
	"bg-white dark:bg-gray-800",
	"rounded-lg",
	"shadow-md dark:shadow-gray-900/20",
	"overflow-hidden",
	"border-2 border-gray-100 dark:border-gray-700",
	"transition-all duration-300",
	"hover:shadow-lg dark:hover:shadow-gray-900/30",
	"hover:scale-105",
	"cursor-pointer",
	recommended
		? "hover:border-green-500 dark:hover:border-green-400 hover:bg-green-50 dark:hover:bg-green-900/20 ring-1 ring-green-200 dark:ring-green-800"
		: "",
].join(" ");
---

<a href={`/bookshelf/${slug}`} class="block">
	<article class={articleClass} aria-labelledby={titleId}>
		{
			recommended && (
				<div class="absolute top-2 right-2 z-10">
					<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300">
						⭐ Recommended
					</span>
				</div>
			)
		}
		<div class="p-4">
			<div class="flex space-x-4">
				<div class="flex-shrink-0 w-20 h-36 relative">
					<img
						src={coverSrc}
						alt={`Cover of ${title} by ${author}`}
						loading="lazy"
						decoding="async"
						class="object-contain transition-opacity duration-300 hover:opacity-90"
						onerror="this.onerror=null;this.src='/blog-placeholder-1.jpg'"
					/>
				</div>
				<div class="flex-grow min-w-0">
					<h2
						id={titleId}
						class="text-lg font-semibold leading-tight text-gray-900 dark:text-white truncate"
						title={title}
					>
						{title}
					</h2>
					<p class="text-xs text-gray-600 dark:text-gray-400 mb-2">{author}</p>
					<StarRating rating={rating} />
					<p class="text-sm mt-2 text-gray-700 dark:text-gray-300 line-clamp-4 leading-relaxed">
						{description}
					</p>
				</div>
			</div>
		</div>
	</article>
</a>
